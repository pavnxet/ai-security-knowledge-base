{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-kb/schema/check.schema.json",
  "title": "secure-kb atomic check card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "platforms",
    "stacks",
    "domain",
    "phase",
    "severity",
    "priority",
    "cwe",
    "owasp",
    "check",
    "fix",
    "detect",
    "verify_evidence",
    "tags",
    "sources",
    "origin",
    "confidence",
    "last_verified",
    "extraction",
    "verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SKB-[A-Z0-9]+-[A-Z0-9-]+$",
      "minLength": 8,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 5,
      "maxLength": 140
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "web",
          "api",
          "mobile",
          "android",
          "ios",
          "telegram",
          "cloud",
          "iot",
          "web3",
          "llm",
          "vibe",
          "browser-ext",
          "desktop",
          "generic"
        ]
      }
    },
    "stacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "domain": {
      "enum": [
        "access-control",
        "api",
        "auth",
        "business-logic",
        "config",
        "crypto",
        "csrf",
        "data-protection",
        "deserialization",
        "error-handling",
        "file-upload",
        "firmware",
        "headers",
        "infra",
        "injection",
        "input-validation",
        "llm",
        "logging",
        "network",
        "privacy",
        "rate-limiting",
        "secrets",
        "session",
        "smart-contract",
        "ssrf",
        "storage",
        "supply-chain",
        "webhook",
        "xss"
      ]
    },
    "phase": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "pr-review",
          "pre-launch",
          "full-audit"
        ]
      }
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "cwe": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CWE-[0-9]+$"
      }
    },
    "owasp": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "check": {
      "type": "string",
      "minLength": 10,
      "maxLength": 600
    },
    "fix": {
      "type": "string",
      "minLength": 5,
      "maxLength": 600
    },
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grep",
        "files"
      ],
      "properties": {
        "grep": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semgrep_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verify_evidence": {
      "type": "string",
      "minLength": 5
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "url",
          "license",
          "type"
        ],
        "properties": {
          "repo": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "type": {
            "enum": [
              "github",
              "official-doc",
              "spec",
              "authored"
            ]
          },
          "extraction": {
            "enum": [
              "programmatic",
              "manual-paraphrase",
              "from-memory",
              "authored"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "anchor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "origin": {
      "enum": [
        "distilled",
        "authored"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "last_verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "extraction": {
      "enum": [
        "programmatic",
        "manual-paraphrase",
        "from-memory",
        "authored"
      ]
    },
    "verified": {
      "type": "boolean"
    },
    "corroboration": {
      "type": "integer",
      "minimum": 1
    },
    "merged_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replaced_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "cwe_source": {
      "enum": [
        "extracted",
        "heuristic",
        "mapped"
      ]
    }
  }
}